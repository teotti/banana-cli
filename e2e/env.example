# Copy into the environment, or into the gitignored .env at the repo root.
# bun run e2e reads either. Do not commit real values.

# Staging API. Writes are refused against https://api.bananasplit.net.
BANANASPLIT_E2E_API_URL=
# Optional when auth is not <api-origin>/api.
BANANASPLIT_E2E_AUTH_URL=

# Dedicated staging user. banana me --json must return this id.
BANANASPLIT_E2E_ACCOUNT_ID=
# A non-guest friend of that user. The name must not contain "=".
# The account also needs a guest friend, and at least one other friend.
BANANASPLIT_E2E_PARTNER_ID=
BANANASPLIT_E2E_PARTNER_NAME=
BANANASPLIT_E2E_PARTNER_USERNAME=
# Optional. Leave empty when the partner has no email. The email case is skipped.
BANANASPLIT_E2E_PARTNER_EMAIL=
# A proper prefix of the name, username, or email. It must match only this person.
BANANASPLIT_E2E_PARTNER_PREFIX=
# A fragment inside one of those labels that is not itself a prefix.
BANANASPLIT_E2E_PARTNER_SUBSTRING=
BANANASPLIT_E2E_CURRENCY=EUR

# Isolated credential directory. Defaults to ~/.local/share/banana-e2e.
# BANANASPLIT_E2E_HOME=
# Production smoke uses a different directory. Defaults to ~/.local/share/banana-e2e-production.
# BANANASPLIT_E2E_PRODUCTION_HOME=
# BANANASPLIT_E2E_PRODUCTION_ACCOUNT_ID=
# BANANASPLIT_E2E_BINARY=
